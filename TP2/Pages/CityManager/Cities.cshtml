@page
@model CitiesModel
@* Exercício: 9 *@
@{
    ViewData["Title"] = "Exercício 9";
}

<h1>Cidades</h1>
<p class="text-muted">Clique em uma cidade para ver os detalhes.</p>

<ul class="list-group">
    @foreach (var city in Model.Cities)
    {
        <li class="list-group-item">
            <a asp-page="/CityManager/CityDetails" asp-route-cityName="@city">@city</a>
        </li>
    }
</ul>
