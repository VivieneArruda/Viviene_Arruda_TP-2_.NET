@page
@model CreateCityClientModel
@* Exercício: 4 *@
@{
    ViewData["Title"] = "Exercício 4";
}

<h1>Cadastro de cidade</h1>
<p class="text-muted">Validação no navegador, usando as mesmas regras do servidor.</p>

<form method="post">
    <div class="mb-3">
        <label asp-for="Input.CityName" class="form-label"></label>
        <input asp-for="Input.CityName" class="form-control" />
        <span asp-validation-for="Input.CityName" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Enviar</button>
</form>

@if (Model.Message != null)
{
    <div class="alert alert-success mt-3">@Model.Message</div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
