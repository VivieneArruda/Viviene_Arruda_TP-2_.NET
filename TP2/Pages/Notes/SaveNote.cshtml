@page
@model SaveNoteModel
@* Exercício: 10 *@
@{
    ViewData["Title"] = "Exercício 10";
}

<h1>Nova nota</h1>
<p class="text-muted">O texto é salvo em um arquivo .txt dentro de wwwroot/files.</p>

<form method="post">
    <div class="mb-3">
        <label asp-for="Input.Content" class="form-label"></label>
        <textarea asp-for="Input.Content" class="form-control" rows="6"></textarea>
        <span asp-validation-for="Input.Content" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Salvar nota</button>
</form>

@if (Model.FileName != null)
{
    <div class="alert alert-success mt-3">
        Nota salva no arquivo <strong>@Model.FileName</strong>.
        <a href="~/files/@Model.FileName" download>Baixar arquivo</a>
    </div>
}

<p class="mt-3"><a asp-page="/Notes/ReadNotes">Ver todas as notas</a></p>
